        "command": [
          "autocomplete",
          "wallpaper"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Variant",
        "icon": "colors",
        "description": "Change the current scheme variant",
        "command": [
          "autocomplete",
          "variant"
