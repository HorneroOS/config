{
  "appearance": {
    "font": {
      "family": {
        "sans": "Inter",
        "mono": "IBM Plex Mono"
      },
      "size": {
        "scale": 1.1
      }
    },
    "anim": {
      "mediaGifSpeedAdjustment": 300,
      "sessionGifSpeed": 0.7,
      "durations": {
        "scale": 0.8
      }
    },
    "transparency": {
      "layers": 0.4,
      "elements": {},
      "enabled": true,
      "base": 0.7
    },
    "theme": "hornero-signal-night",
    "highContrast": true,
    "rounding": {
      "scale": 1.4
    },
    "spacing": {
      "scale": 1.2
    },
    "padding": {
      "scale": 0.9
    }
  },
  "general": {
    "logo": "",
    "apps": {
      "terminal": [
        "kitty"
      ],
      "audio": [
        "pavucontrol"
      ],
      "playback": [
        "mpv"
      ],
      "explorer": [
        "thunar"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "timeouts": [
        {
          "timeout": 180,
          "idleAction": "lock"
        },
        {
          "timeout": 300,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        },
        {
          "timeout": 600,
          "idleAction": [
            "systemctl",
            "suspend-then-hibernate"
          ]
        }
      ],
      "inhibitWhenAudio": false
    },
    "battery": {
      "criticalLevel": 5,
      "warnLevels": [
        {
          "level": 20,
          "title": "Low battery",
          "message": "You might want to plug in a charger",
          "icon": "battery-2"
        },
        {
          "level": 10,
          "title": "Did you see the previous message?",
          "message": "You should probably plug in a charger <b>now</b>",
          "icon": "battery-1"
        },
        {
          "level": 5,
          "title": "Critical battery level",
          "message": "PLUG THE CHARGER RIGHT NOW!!",
          "icon": "battery-exclamation",
          "critical": true
        }
      ]
    }
  },
  "background": {
    "enabled": true,
    "wallpaperEnabled": true,
    "desktopClock": {
      "invertColors": false,
      "background": {
        "enabled": false,
        "opacity": 0.7,
        "blur": true
      },
      "shadow": {
        "enabled": true,
        "opacity": 0.7,
        "blur": 0.4
      },
      "enabled": true,
      "position": "top-left",
      "scale": 1.5
    },
    "visualiser": {
      "autoHide": true,
      "blur": false,
      "rounding": 1,
      "spacing": 1,
      "enabled": true
    },
    "video": {
      "enabled": true,
      "pauseOnFullscreen": true,
      "batteryLimitEnabled": false,
      "pauseOnGameMode": true,
      "batteryLimit": 35
    }
  },
  "bar": {
    "dragThreshold": 20,
    "perScreen": [],
    "bars": [
      {
        "edge": "left",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 40,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "activeWindow",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            },
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "tray",
              "enabled": true,
              "options": {}
            },
            {
              "id": "extensions",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ],
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    },
    "popouts": {
      "activeWindow": true,
      "tray": true,
      "statusIcons": true
    },
    "workspaces": {
      "maxWindowIcons": 5,
      "activeIndicator": true,
      "occupiedBg": true,
      "showWindows": true,
      "showWindowsOnSpecialWorkspaces": true,
      "perMonitorWorkspaces": true,
      "label": "",
      "occupiedLabel": "",
      "activeLabel": "",
      "capitalisation": "preserve",
      "specialWorkspaceIcons": [],
      "shown": 8,
      "activeTrail": true
    },
    "activeWindow": {
      "inverted": false
    },
    "tray": {
      "background": false,
      "iconSubs": [],
      "hiddenIcons": [],
      "compact": true,
      "recolour": true
    },
    "extensions": {
      "background": false,
      "compact": false,
      "iconSubs": [],
      "hiddenIcons": [],
      "recolour": true
    },
    "status": {
      "showKbLayout": false,
      "showNetwork": true,
      "showWifi": true,
      "showBluetooth": true,
      "showLockStatus": true,
      "showMicrophone": true,
      "showBattery": false,
      "showAudio": true
    },
    "clock": {
      "showIcon": true,
      "background": false,
      "showDate": true
    },
    "sizes": {
      "windowPreviewSize": 400,
      "trayMenuWidth": 300,
      "batteryWidth": 250,
      "networkWidth": 320,
      "kbLayoutWidth": 320,
      "innerWidth": 32
    },
    "excludedScreens": [],
    "persistent": false,
    "showOnHover": false
  },
  "border": {
    "frameEnabled": true,
    "thickness": 6,
    "rounding": 18
  },
  "dashboard": {
    "enabled": true,
    "resourceUpdateInterval": 1000,
    "dragThreshold": 50,
    "performance": {
      "showBattery": true,
      "showCpu": true,
      "showMemory": true,
      "showStorage": true,
      "showNetwork": true,
      "showGpu": false
    },
    "workspaces": {
      "showLivePreview": true,
      "showSpecialWorkspaces": true,
      "showWindowBadges": true,
      "showMonitorBadge": true,
      "enableWindowActions": true,
      "maxAppIcons": 6,
      "previewHeight": 240
    },
    "sizes": {
      "tabIndicatorHeight": 3,
      "tabIndicatorSpacing": 5,
      "infoWidth": 200,
      "infoIconSize": 25,
      "dateTimeWidth": 110,
      "mediaWidth": 200,
      "mediaProgressSweep": 180,
      "mediaProgressThickness": 8,
      "resourceProgessThickness": 10,
      "mediaCoverArtSize": 150,
      "mediaVisualiserSize": 80,
      "resourceSize": 200,
      "weatherWidth": 300
    },
    "showOnHover": false,
    "mediaUpdateInterval": 1000
  },
  "controlCenter": {
    "sizes": {
      "ratio": 1.7777777777777777,
      "heightMult": 0.8
    }
  },
  "launcher": {
    "enabled": true,
    "showOnHover": false,
    "specialPrefix": "@",
    "actionPrefix": ">",
    "enableDangerousActions": false,
    "dragThreshold": 50,
    "hiddenApps": [],
    "useFuzzy": {
      "actions": false,
      "wallpapers": false,
      "apps": true
    },
    "sizes": {
      "wallpaperHeight": 200,
      "wallpaperWidth": 320,
      "itemHeight": 44,
      "itemWidth": 640
    },
    "maxShown": 10,
    "maxWallpapers": 12,
    "vimKeybinds": true,
    "favouriteApps": [
      "org.mozilla.firefox",
      "foot"
    ],
    "actions": [
      {
        "name": "Calculator",
        "icon": "calculator",
        "description": "Do simple math equations (powered by Qalc)",
        "command": [
          "autocomplete",
          "calc"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Wallpaper",
        "icon": "photo",
        "description": "Change the current wallpaper",
        "command": [
          "autocomplete",
          "wallpaper"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Themes",
        "icon": "brush",
        "description": "Apply a desktop theme pack",
        "command": [
          "autocomplete",
          "theme"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Layout",
        "icon": "layout-dashboard",
        "description": "Change the shell bar layout",
        "command": [
          "layoutpicker"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Transparency",
        "icon": "opacity",
        "description": "Change shell transparency",
        "command": [
          "autocomplete",
          "transparency"
        ],
        "enabled": false,
        "dangerous": false
      },
      {
        "name": "Random",
        "icon": "dice-5",
        "description": "Switch to a random wallpaper",
        "command": [
          "sh",
          "-c",
          "f=\"$(find -L \"$HOME/Pictures/Wallpapers\" -type f | shuf -n 1)\"; [ -n \"$f\" ] && horneroctl wallpaper set --yes \"$f\""
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Light",
        "icon": "sun",
        "description": "Switch to Hornero Signal Day",
        "command": [
          "theme",
          "hornero-signal-day"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Dark",
        "icon": "moon",
        "description": "Switch to Hornero Signal Night",
        "command": [
          "theme",
          "hornero-signal-night"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Shutdown",
        "icon": "power",
        "description": "Shutdown the system",
        "command": [
          "systemctl",
          "poweroff"
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Reboot",
        "icon": "refresh",
        "description": "Reboot the system",
        "command": [
          "systemctl",
          "reboot"
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Logout",
        "icon": "logout",
        "description": "Log out of the current session",
        "command": [
          "loginctl",
          "terminate-user",
          ""
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Lock",
        "icon": "lock",
        "description": "Lock the current session",
        "command": [
          "loginctl",
          "lock-session"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Sleep",
        "icon": "moon-stars",
        "description": "Suspend then hibernate",
        "command": [
          "systemctl",
          "suspend-then-hibernate"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Settings",
        "icon": "settings",
        "description": "Configure the shell",
        "command": [
          "horneroctl",
          "config",
          "gui"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Focus mode",
        "icon": "circle-dot",
        "description": "Experience: maximum space, quiet motion, notifications held",
        "command": [
          "mode",
          "focus"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Everyday mode",
        "icon": "layout-dashboard",
        "description": "Experience: the balanced default",
        "command": [
          "mode",
          "everyday"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Signal mode",
        "icon": "wave-sine",
        "description": "Experience: immersive instruments, labelled telemetry and glow",
        "command": [
          "mode",
          "signal"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Gaming mode",
        "icon": "device-gamepad-2",
        "description": "Experience: no motion, queued notifications, paused telemetry",
        "command": [
          "mode",
          "gaming"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Studio mode",
        "icon": "wave-square",
        "description": "Experience: audio first, stable canvas",
        "command": [
          "mode",
          "studio"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Revert mode",
        "icon": "history",
        "description": "Experience: go back to the previous mode",
        "command": [
          "mode",
          "revert"
        ],
        "enabled": true,
        "dangerous": false
      }
    ]
  },
  "notifs": {
    "expire": true,
    "clearThreshold": 0.3,
    "expandThreshold": 20,
    "sizes": {
      "image": 41,
      "badge": 20,
      "width": 440
    },
    "defaultExpireTimeout": 8000,
    "actionOnClick": true,
    "openExpanded": true,
    "groupPreviewNum": 5
  },
  "osd": {
    "enabled": true,
    "enableBrightness": true,
    "sizes": {
      "sliderWidth": 30,
      "sliderHeight": 180
    },
    "hideDelay": 1500,
    "enableMicrophone": true
  },
  "session": {
    "enabled": true,
    "dragThreshold": 30,
    "icons": {
      "logout": "logout",
      "hibernate": "zzz",
      "reboot": "refresh",
      "shutdown": "power"
    },
    "commands": {
      "logout": [
        "loginctl",
        "terminate-user",
        ""
      ],
      "shutdown": [
        "systemctl",
        "poweroff"
      ],
      "hibernate": [
        "systemctl",
        "hibernate"
      ],
      "reboot": [
        "systemctl",
        "reboot"
      ]
    },
    "vimKeybinds": true,
    "sizes": {
      "button": 96
    }
  },
  "winfo": {
    "sizes": {
      "heightMult": 0.7,
      "detailsWidth": 500
    }
  },
  "lock": {
    "recolourLogo": false,
    "enableFprint": true,
    "sizes": {
      "heightMult": 0.7,
      "ratio": 1.7777777777777777,
      "centerWidth": 640
    },
    "hideNotifs": false,
    "maxFprintTries": 5
  },
  "utilities": {
    "enabled": true,
    "sizes": {
      "width": 430,
      "toastWidth": 430
    },
    "toasts": {
      "chargingChanged": true,
      "dndChanged": true,
      "audioOutputChanged": true,
      "audioInputChanged": true,
      "capsLockChanged": true,
      "kbLayoutChanged": true,
      "kbLimit": true,
      "vpnChanged": true,
      "nowPlaying": true,
      "configLoaded": false,
      "numLockChanged": false,
      "routineQuiet": true
    },
    "vpn": {
      "enabled": false,
      "provider": [
        "netbird"
      ]
    },
    "maxToasts": 3
  },
  "sidebar": {
    "enabled": true,
    "dragThreshold": 60,
    "sizes": {
      "width": 480
    }
  },
  "services": {
    "weatherLocation": "",
    "useFahrenheitPerformance": false,
    "gpuType": "",
    "visualiserBars": 45,
    "brightnessIncrement": 0.1,
    "maxVolume": 1.0,
    "smartScheme": true,
    "playerAliases": [
      {
        "from": "com.github.th_ch.youtube_music",
        "to": "YT Music"
      }
    ],
    "useFahrenheit": true,
    "audioIncrement": 0.05,
    "defaultPlayer": "mpv"
  },
  "paths": {
    "sessionGif": "root:/assets/kurukuru.gif",
    "mediaGif": "root:/assets/bongocat.gif"
  },
  "plugins": {
    "settings": {},
    "desktopWidgetSlots": {},
    "dashboardLayout": {},
    "safeMode": false
  },
  "experience": {
    "toasts": false
  }
}
