{
  "appearance": {
    "rounding": {
      "scale": 1.3
    }
  },
  "bar": {
    "persistent": false,
    "bars": [
      {
        "edge": "top",
        "style": "inset",
        "reserve": true,
        "margin": 18,
        "thickness": 42,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "audioSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            },
            {
              "id": "brightnessSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {
                "showDate": true
              }
            },
            {
              "id": "weather",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "modeIndicator",
              "enabled": true,
              "options": {}
            },
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "tray",
              "enabled": true,
              "options": {}
            },
            {
              "id": "extensions",
              "enabled": true,
              "options": {}
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        },
        "radius": 11
      },
      {
        "edge": "bottom",
        "style": "attached",
        "reserve": true,
        "margin": 0,
        "thickness": 28,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "media",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "kbLayout",
              "enabled": true,
              "options": {}
            },
            {
              "id": "resources",
              "enabled": true,
              "options": {}
            },
            {
              "id": "battery",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ],
    "extensions": {
      "recolour": true
    },
    "sizes": {
      "innerWidth": 24
    },
    "status": {
      "showAudio": true,
      "showBattery": false
    },
    "tray": {
      "recolour": true
    }
  },
  "utilities": {
    "toasts": {
      "configLoaded": false,
      "numLockChanged": false,
      "routineQuiet": true
    }
  },
  "general": {
    "battery": {
      "warnLevels": [
        {
          "level": 20,
          "title": "Low battery",
          "message": "You might want to plug in a charger",
          "icon": "battery-2"
        },
        {
          "level": 10,
          "title": "Did you see the previous message?",
          "message": "You should probably plug in a charger <b>now</b>",
          "icon": "battery-1"
        },
        {
          "level": 5,
          "title": "Critical battery level",
          "message": "PLUG THE CHARGER RIGHT NOW!!",
          "icon": "battery-exclamation",
          "critical": true
        }
      ]
    }
  },
  "launcher": {
    "actions": [
      {
        "name": "Calculator",
        "icon": "calculator",
        "description": "Do simple math equations (powered by Qalc)",
        "command": [
          "autocomplete",
          "calc"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Wallpaper",
        "icon": "photo",
        "description": "Change the current wallpaper",
        "command": [
          "autocomplete",
          "wallpaper"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Themes",
        "icon": "brush",
        "description": "Apply a desktop theme pack",
        "command": [
          "autocomplete",
          "theme"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Layout",
        "icon": "layout-dashboard",
        "description": "Change the shell bar layout",
        "command": [
          "layoutpicker"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Transparency",
        "icon": "opacity",
        "description": "Change shell transparency",
        "command": [
          "autocomplete",
          "transparency"
        ],
        "enabled": false,
        "dangerous": false
      },
      {
        "name": "Random",
        "icon": "dice-5",
        "description": "Switch to a random wallpaper",
        "command": [
          "sh",
          "-c",
          "f=\"$(find -L \"$HOME/Pictures/Wallpapers\" -type f | shuf -n 1)\"; [ -n \"$f\" ] && horneroctl wallpaper set --yes \"$f\""
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Light",
        "icon": "sun",
        "description": "Switch to Hornero Signal Day",
        "command": [
          "theme",
          "hornero-signal-day"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Dark",
        "icon": "moon",
        "description": "Switch to Hornero Signal Night",
        "command": [
          "theme",
          "hornero-signal-night"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Shutdown",
        "icon": "power",
        "description": "Shutdown the system",
        "command": [
          "systemctl",
          "poweroff"
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Reboot",
        "icon": "refresh",
        "description": "Reboot the system",
        "command": [
          "systemctl",
          "reboot"
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Logout",
        "icon": "logout",
        "description": "Log out of the current session",
        "command": [
          "loginctl",
          "terminate-user",
          ""
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Lock",
        "icon": "lock",
        "description": "Lock the current session",
        "command": [
          "loginctl",
          "lock-session"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Sleep",
        "icon": "moon-stars",
        "description": "Suspend then hibernate",
        "command": [
          "systemctl",
          "suspend-then-hibernate"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Settings",
        "icon": "settings",
        "description": "Configure the shell",
        "command": [
          "horneroctl",
          "config",
          "gui"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Focus mode",
        "icon": "circle-dot",
        "description": "Experience: maximum space, quiet motion, notifications held",
        "command": [
          "mode",
          "focus"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Everyday mode",
        "icon": "layout-dashboard",
        "description": "Experience: the balanced default",
        "command": [
          "mode",
          "everyday"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Signal mode",
        "icon": "wave-sine",
        "description": "Experience: immersive instruments, labelled telemetry and glow",
        "command": [
          "mode",
          "signal"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Gaming mode",
        "icon": "device-gamepad-2",
        "description": "Experience: no motion, queued notifications, paused telemetry",
        "command": [
          "mode",
          "gaming"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Studio mode",
        "icon": "wave-square",
        "description": "Experience: audio first, stable canvas",
        "command": [
          "mode",
          "studio"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Revert mode",
        "icon": "history",
        "description": "Experience: go back to the previous mode",
        "command": [
          "mode",
          "revert"
        ],
        "enabled": true,
        "dangerous": false
      }
    ],
    "maxShown": 8,
    "sizes": {
      "itemHeight": 44,
      "itemWidth": 640
    }
  },
  "session": {
    "icons": {
      "hibernate": "zzz",
      "reboot": "refresh",
      "shutdown": "power"
    }
  }
}
