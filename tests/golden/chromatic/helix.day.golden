# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette hornero-signal-day (light). Select in ~/.config/helix/config.toml: theme = "hornero-chromatic"

"ui.background" = { bg = "base" }
"ui.background.separator" = { fg = "rule" }
"ui.cursor" = { fg = "onSignal", bg = "signal" }
"ui.cursor.primary" = { fg = "onSignal", bg = "signal" }
"ui.cursor.match" = { fg = "onCueWell", bg = "cueWell", modifiers = ["bold"] }
"ui.cursor.insert" = { fg = "onCue", bg = "cue" }
"ui.cursor.select" = { fg = "onPhosphor", bg = "phosphor" }
"ui.cursorline.primary" = { bg = "panel" }
"ui.cursorline.secondary" = { bg = "sunken" }
"ui.selection" = { fg = "onCueWell", bg = "cueWell" }
"ui.selection.primary" = { fg = "onCueWell", bg = "cueWell" }
"ui.linenr" = { fg = "inkFaint" }
"ui.linenr.selected" = { fg = "signal", modifiers = ["bold"] }
"ui.statusline" = { fg = "ink", bg = "ground" }
"ui.statusline.inactive" = { fg = "inkMuted", bg = "sunken" }
"ui.statusline.normal" = { fg = "onCue", bg = "cue", modifiers = ["bold"] }
"ui.statusline.insert" = { fg = "onPhosphor", bg = "phosphor", modifiers = ["bold"] }
"ui.statusline.select" = { fg = "onSignal", bg = "signal", modifiers = ["bold"] }
"ui.bufferline" = { fg = "inkMuted", bg = "ground" }
"ui.bufferline.active" = { fg = "ink", bg = "base", underline = { color = "signal", style = "line" } }
"ui.bufferline.background" = { bg = "ground" }
"ui.popup" = { fg = "ink", bg = "raised" }
"ui.popup.info" = { fg = "ink", bg = "lifted" }
"ui.window" = { fg = "ruleStrong" }
"ui.help" = { fg = "ink", bg = "lifted" }
"ui.text" = { fg = "ink" }
"ui.text.focus" = { fg = "ink", bg = "raised", modifiers = ["bold"] }
"ui.text.inactive" = { fg = "inkMuted" }
"ui.text.info" = { fg = "ink" }
"ui.text.directory" = { fg = "cue" }
"ui.virtual.whitespace" = { fg = "rule" }
"ui.virtual.ruler" = { bg = "panel" }
"ui.virtual.indent-guide" = { fg = "rule" }
"ui.virtual.inlay-hint" = { fg = "inkMuted", bg = "sunken" }
"ui.menu" = { fg = "ink", bg = "raised" }
"ui.menu.selected" = { fg = "onCueWell", bg = "cueWell", modifiers = ["bold"] }
"ui.menu.scroll" = { fg = "ruleStrong", bg = "panel" }
"ui.highlight" = { bg = "raised" }

"diagnostic.error" = { underline = { color = "alert", style = "curl" } }
"diagnostic.warning" = { underline = { color = "signal", style = "curl" } }
"diagnostic.info" = { underline = { color = "cue", style = "curl" } }
"diagnostic.hint" = { underline = { color = "phosphor", style = "curl" } }
"error" = "alert"
"warning" = "signal"
"info" = "cue"
"hint" = "phosphor"

"diff.plus" = "phosphor"
"diff.minus" = "alert"
"diff.delta" = "signal"

"comment" = { fg = "inkMuted", modifiers = ["italic"] }
"constant" = "signal"
"constant.numeric" = "signal"
"constant.character.escape" = "cue"
"string" = "phosphor"
"string.regexp" = "cue"
"keyword" = { fg = "term5", modifiers = ["bold"] }
"keyword.control" = "term5"
"operator" = "inkMuted"
"function" = "cue"
"function.builtin" = "term6"
"type" = "signal"
"variable" = "ink"
"variable.parameter" = "ink"
"variable.other.member" = "term6"
"attribute" = "term5"
"namespace" = "cue"
"punctuation" = "inkMuted"
"tag" = "alert"
"label" = "cue"
"markup.heading" = { fg = "signal", modifiers = ["bold"] }
"markup.link.url" = { fg = "cue", underline = { style = "line" } }
"markup.link.text" = "phosphor"
"markup.raw" = "term6"
"markup.quote" = { fg = "inkMuted", modifiers = ["italic"] }

[palette]
ground = "#E8EDF4"
sunken = "#E0E6EF"
base = "#EEF2F7"
panel = "#F5F8FC"
raised = "#FCFCFE"
lifted = "#FFFFFF"
ink = "#283344"
inkMuted = "#505E70"
inkFaint = "#606D80"
rule = "#D2DAE6"
ruleStrong = "#7A8798"
signal = "#864700"
onSignal = "#FFFFFF"
signalWell = "#FCE9C8"
onSignalWell = "#432300"
cue = "#145D86"
onCue = "#FFFFFF"
cueWell = "#D8EEF9"
onCueWell = "#0B334B"
phosphor = "#1E6448"
onPhosphor = "#FFFFFF"
phosphorWell = "#D6F4E8"
onPhosphorWell = "#0E3425"
alert = "#9C293E"
onAlert = "#FFFFFF"
alertWell = "#FADDE4"
onAlertWell = "#4E111E"
focus = "#145D86"
glow = "#864700"
term1 = "#9C293E"
term2 = "#1E6448"
term3 = "#864700"
term4 = "#145D86"
term5 = "#6A3FA0"
term6 = "#11666E"
