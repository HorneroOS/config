# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette hornero-signal-day (light). Include in ~/.config/git/config.user:
#   [include]
#     path = ~/.config/git/hornero-chromatic.gitconfig
#   [delta]
#     features = hornero-chromatic
[delta "hornero-chromatic"]


  dark = false
  light = true

  file-style = "#8F4B00 bold"
  file-decoration-style = "#736D62 ul"
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "#1A5F88 bold"
  hunk-header-line-number-style = "#4E545B"
  hunk-header-decoration-style = "#D3CCBD box"
  line-numbers = true
  line-numbers-left-style = "#7A8086"
  line-numbers-right-style = "#7A8086"
  line-numbers-minus-style = "#A8341C"
  line-numbers-plus-style = "#256A3B"
  line-numbers-zero-style = "#7A8086"
  minus-style = "#4A1209 #F7D7D0"
  minus-emph-style = "#FFFFFF #A8341C bold"
  minus-non-emph-style = "#4A1209 #F7D7D0"
  plus-style = "#0E2E17 #D5EBD9"
  plus-emph-style = "#FFFFFF #256A3B bold"
  plus-non-emph-style = "#0E2E17 #D5EBD9"
  zero-style = "#1B1E22 #F2EEE5"
  whitespace-error-style = "#FFFFFF #A8341C reverse"
  blame-palette = "#F2EEE5 #F7F4EE #FBF9F5 #FFFFFF"
  commit-decoration-style = "#8F4B00 box"
  commit-style = "#8F4B00 bold"
  grep-file-style = "#1A5F88 bold"
  grep-line-number-style = "#4E545B"
  grep-match-style = "#FFFFFF #8F4B00 bold"

[color "diff"]
  meta = "#1A5F88 bold"
  frag = "#8F4B00 bold"
  func = "#4E545B"
  old = "#A8341C"
  new = "#256A3B"
  context = "#1B1E22"
  commit = "#8F4B00"
  whitespace = "#A8341C reverse"

[color "branch"]
  current = "#8F4B00 reverse"
  local = "#1B1E22"
  remote = "#256A3B"
  upstream = "#1A5F88"

[color "status"]
  added = "#256A3B"
  changed = "#8F4B00"
  untracked = "#1A5F88"
  deleted = "#A8341C"
  branch = "#8F4B00 bold"
