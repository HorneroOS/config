# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette hornero-signal-day (light). Include in ~/.config/git/config.user:
#   [include]
#     path = ~/.config/git/hornero-chromatic.gitconfig
#   [delta]
#     features = hornero-chromatic
[delta "hornero-chromatic"]


  dark = false
  light = true

  file-style = "#864700 bold"
  file-decoration-style = "#7A8798 ul"
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "#145D86 bold"
  hunk-header-line-number-style = "#505E70"
  hunk-header-decoration-style = "#D2DAE6 box"
  line-numbers = true
  line-numbers-left-style = "#606D80"
  line-numbers-right-style = "#606D80"
  line-numbers-minus-style = "#9C293E"
  line-numbers-plus-style = "#1E6448"
  line-numbers-zero-style = "#606D80"
  minus-style = "#4E111E #FADDE4"
  minus-emph-style = "#FFFFFF #9C293E bold"
  minus-non-emph-style = "#4E111E #FADDE4"
  plus-style = "#0E3425 #D6F4E8"
  plus-emph-style = "#FFFFFF #1E6448 bold"
  plus-non-emph-style = "#0E3425 #D6F4E8"
  zero-style = "#283344 #EEF2F7"
  whitespace-error-style = "#FFFFFF #9C293E reverse"
  blame-palette = "#EEF2F7 #F5F8FC #FCFCFE #FFFFFF"
  commit-decoration-style = "#864700 box"
  commit-style = "#864700 bold"
  grep-file-style = "#145D86 bold"
  grep-line-number-style = "#505E70"
  grep-match-style = "#FFFFFF #864700 bold"

[color "diff"]
  meta = "#145D86 bold"
  frag = "#864700 bold"
  func = "#505E70"
  old = "#9C293E"
  new = "#1E6448"
  context = "#283344"
  commit = "#864700"
  whitespace = "#9C293E reverse"

[color "branch"]
  current = "#864700 reverse"
  local = "#283344"
  remote = "#1E6448"
  upstream = "#145D86"

[color "status"]
  added = "#1E6448"
  changed = "#864700"
  untracked = "#145D86"
  deleted = "#9C293E"
  branch = "#864700 bold"
