/* Palette hornero-signal-day (light) */
* {
    hornero-base: #EEF2F7;
    hornero-ground: #E8EDF4;
    hornero-raised: #FCFCFE;
    hornero-ink: #283344;
    hornero-ink-muted: #505E70;
    hornero-signal: #864700;
    hornero-on-signal: #FFFFFF;
    hornero-cue: #145D86;
    hornero-cue-well: #D8EEF9;
    hornero-on-cue-well: #0B334B;
    hornero-rule: #D2DAE6;
    background-color: transparent;
    text-color: @hornero-ink;
}
