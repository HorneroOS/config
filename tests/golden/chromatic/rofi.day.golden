* {
    hornero-base: #F2EEE5;
    hornero-ground: #E6E1D5;
    hornero-raised: #FBF9F5;
    hornero-ink: #1B1E22;
    hornero-ink-muted: #4E545B;
    hornero-signal: #8F4B00;
    hornero-on-signal: #FFFFFF;
    hornero-cue: #1A5F88;
    hornero-cue-well: #D3E7F3;
    hornero-on-cue-well: #0B2E44;
