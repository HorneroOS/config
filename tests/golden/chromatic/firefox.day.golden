  --hornero-base: #EEF2F7;
  --hornero-panel: #F5F8FC;
  --hornero-raised: #FCFCFE;
  --hornero-lifted: #FFFFFF;
  --hornero-sunken: #E0E6EF;
  --hornero-ink: #283344;
  --hornero-ink-muted: #505E70;
  --hornero-ink-faint: #606D80;
  --hornero-signal: #864700;
  --hornero-on-signal: #FFFFFF;
  --hornero-cue: #145D86;
  --hornero-cue-well: #D8EEF9;
  --hornero-on-cue-well: #0B334B;
  --hornero-rule: #D2DAE6;
  --hornero-rule-strong: #7A8798;

  --lwt-accent-color: #E8EDF4 !important;
  --lwt-text-color: #283344 !important;
  --toolbar-bgcolor: #EEF2F7 !important;
  --toolbar-color: #283344 !important;
  --toolbar-field-background-color: #E0E6EF !important;
  --toolbar-field-color: #283344 !important;
  --toolbar-field-border-color: #D2DAE6 !important;
  --toolbar-field-focus-background-color: #FCFCFE !important;
  --toolbar-field-focus-border-color: #864700 !important;
  --toolbarseparator-color: #D2DAE6 !important;
  --tab-selected-bgcolor: #FCFCFE !important;
