-- Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
-- Palette hornero-signal-night (dark). Usage: :colorscheme hornero-chromatic
vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
  vim.cmd("syntax reset")
end

vim.o.termguicolors = true
vim.o.background = "dark"
vim.g.colors_name = "hornero-chromatic"

local c = {
  ground = "#0C1016",
  sunken = "#10151C",
  base = "#141B24",
  panel = "#1B2430",
  raised = "#24303D",
  lifted = "#2C3947",
  ink = "#E6EBF1",
  inkMuted = "#A9B7C6",
  inkFaint = "#8999AB",
  rule = "#2D3B4B",
  ruleStrong = "#8393A6",
  signal = "#F2AC52",
  onSignal = "#1E1304",
  signalWell = "#3D2B12",
  onSignalWell = "#FFE0B0",
  cue = "#8BCEF0",
  onCue = "#071A26",
  cueWell = "#163345",
  onCueWell = "#D6EFFC",
  phosphor = "#8DDBAF",
  onPhosphor = "#071D12",
  phosphorWell = "#153425",
  onPhosphorWell = "#D1F5E0",
  alert = "#FF8494",
  onAlert = "#24070C",
  alertWell = "#421922",
  onAlertWell = "#FFD6DC",
  inverse = "#E6EBF1",
  onInverse = "#1B2430",
  inverseSignal = "#864700",
  focus = "#8BCEF0",
  glow = "#FFC06B",
  term1 = "#FF8494",
  term2 = "#8DDBAF",
  term3 = "#F2AC52",
  term4 = "#8BCEF0",
  term5 = "#C9A5F5",
  term6 = "#76D8CE",
}

local terminal = {
  "#24303D",
  "#FF8494",
  "#8DDBAF",
  "#F2AC52",
  "#8BCEF0",
  "#C9A5F5",
  "#76D8CE",
  "#C5D0DC",
  "#8393A6",
  "#FFA6B2",
  "#B2EBC9",
  "#FFC87D",
  "#B2E0F8",
  "#DEC4FA",
  "#A3EAE2",
  "#E6EBF1",
}

for i = 0, 15 do
  vim.g["terminal_color_" .. i] = terminal[i + 1]
end

local function hl(group, spec)
  vim.api.nvim_set_hl(0, group, spec)
end

-- Core UI
hl("Normal", { fg = c.ink, bg = c.base })
hl("NormalNC", { fg = c.ink, bg = c.base })
hl("NormalFloat", { fg = c.ink, bg = c.panel })
hl("FloatBorder", { fg = c.ruleStrong, bg = c.panel })
hl("FloatTitle", { fg = c.signal, bg = c.panel, bold = true })
hl("Cursor", { fg = c.onSignal, bg = c.signal })
hl("lCursor", { fg = c.onSignal, bg = c.signal })
hl("TermCursor", { fg = c.onSignal, bg = c.signal })
hl("CursorLine", { bg = c.panel })
hl("CursorColumn", { bg = c.panel })
hl("ColorColumn", { bg = c.sunken })
hl("LineNr", { fg = c.inkFaint, bg = c.base })
hl("CursorLineNr", { fg = c.signal, bg = c.panel, bold = true })
hl("SignColumn", { fg = c.inkMuted, bg = c.base })
hl("FoldColumn", { fg = c.inkFaint, bg = c.base })
hl("Folded", { fg = c.inkMuted, bg = c.sunken })
hl("WinSeparator", { fg = c.rule })
hl("VertSplit", { fg = c.rule })

-- Statusline, tabline, winbar
hl("StatusLine", { fg = c.ink, bg = c.ground })
hl("StatusLineNC", { fg = c.inkMuted, bg = c.sunken })
hl("TabLine", { fg = c.inkMuted, bg = c.ground })
hl("TabLineFill", { fg = c.inkFaint, bg = c.ground })
hl("TabLineSel", { fg = c.ink, bg = c.base, bold = true })
hl("WinBar", { fg = c.ink, bg = c.base, bold = true })
hl("WinBarNC", { fg = c.inkMuted, bg = c.base })

-- Popup menu & completion
hl("Pmenu", { fg = c.ink, bg = c.raised })
hl("PmenuSel", { fg = c.onCueWell, bg = c.cueWell, bold = true })
hl("PmenuSbar", { bg = c.panel })
hl("PmenuThumb", { bg = c.ruleStrong })

-- Selection & search
hl("Visual", { fg = c.onCueWell, bg = c.cueWell })
hl("VisualNOS", { fg = c.onCueWell, bg = c.cueWell })
hl("Search", { fg = c.onSignalWell, bg = c.signalWell })
hl("IncSearch", { fg = c.onSignal, bg = c.signal, bold = true })
hl("CurSearch", { fg = c.onSignal, bg = c.signal, bold = true })
hl("MatchParen", { fg = c.cue, bg = c.raised, bold = true })

-- Messages & navigation
hl("Directory", { fg = c.cue, bold = true })
hl("Title", { fg = c.signal, bold = true })
hl("NonText", { fg = c.ruleStrong })
hl("Whitespace", { fg = c.rule })
hl("SpecialKey", { fg = c.ruleStrong })
hl("Conceal", { fg = c.inkMuted })
hl("EndOfBuffer", { fg = c.rule })
hl("ErrorMsg", { fg = c.alert, bold = true })
hl("WarningMsg", { fg = c.signal, bold = true })
hl("MoreMsg", { fg = c.phosphor, bold = true })
hl("Question", { fg = c.cue, bold = true })
hl("ModeMsg", { fg = c.ink, bold = true })

-- Diff & Git
hl("DiffAdd", { fg = c.onPhosphorWell, bg = c.phosphorWell })
hl("DiffChange", { fg = c.onSignalWell, bg = c.signalWell })
hl("DiffDelete", { fg = c.onAlertWell, bg = c.alertWell })
hl("DiffText", { fg = c.onSignal, bg = c.signal, bold = true })
hl("Added", { fg = c.phosphor })
hl("Changed", { fg = c.signal })
hl("Removed", { fg = c.alert })

-- Syntax
hl("Comment", { fg = c.inkMuted, italic = true })
hl("Constant", { fg = c.signal })
hl("String", { fg = c.phosphor })
hl("Character", { fg = c.phosphor })
hl("Number", { fg = c.signal })
hl("Boolean", { fg = c.signal, bold = true })
hl("Float", { fg = c.signal })
hl("Identifier", { fg = c.ink })
hl("Function", { fg = c.cue })
hl("Statement", { fg = c.term5 })
hl("Conditional", { fg = c.term5 })
hl("Repeat", { fg = c.term5 })
hl("Label", { fg = c.cue })
hl("Operator", { fg = c.inkMuted })
hl("Keyword", { fg = c.term5, bold = true })
hl("Exception", { fg = c.alert })
hl("PreProc", { fg = c.term6 })
hl("Include", { fg = c.term5 })
hl("Define", { fg = c.term5 })
hl("Macro", { fg = c.term6 })
hl("PreCondit", { fg = c.term6 })
hl("Type", { fg = c.signal })
hl("StorageClass", { fg = c.signal })
hl("Structure", { fg = c.signal })
hl("Typedef", { fg = c.signal })
hl("Special", { fg = c.term6 })
hl("SpecialChar", { fg = c.cue })
hl("Tag", { fg = c.alert })
hl("Delimiter", { fg = c.inkMuted })
hl("SpecialComment", { fg = c.cue, italic = true })
hl("Debug", { fg = c.alert })
hl("Underlined", { fg = c.cue, underline = true })
hl("Error", { fg = c.onAlert, bg = c.alert, bold = true })
hl("Todo", { fg = c.onSignalWell, bg = c.signalWell, bold = true })

-- Diagnostics & LSP
hl("DiagnosticError", { fg = c.alert })
hl("DiagnosticWarn", { fg = c.signal })
hl("DiagnosticInfo", { fg = c.cue })
hl("DiagnosticHint", { fg = c.phosphor })
hl("DiagnosticOk", { fg = c.phosphor })
hl("DiagnosticVirtualTextError", { fg = c.onAlertWell, bg = c.alertWell })
hl("DiagnosticVirtualTextWarn", { fg = c.onSignalWell, bg = c.signalWell })
hl("DiagnosticVirtualTextInfo", { fg = c.onCueWell, bg = c.cueWell })
hl("DiagnosticVirtualTextHint", { fg = c.onPhosphorWell, bg = c.phosphorWell })
hl("DiagnosticUnderlineError", { sp = c.alert, undercurl = true })
hl("DiagnosticUnderlineWarn", { sp = c.signal, undercurl = true })
hl("DiagnosticUnderlineInfo", { sp = c.cue, undercurl = true })
hl("DiagnosticUnderlineHint", { sp = c.phosphor, undercurl = true })
hl("LspReferenceText", { bg = c.raised })
hl("LspReferenceRead", { bg = c.raised })
hl("LspReferenceWrite", { bg = c.signalWell })

-- Treesitter links
hl("@comment", { link = "Comment" })
hl("@string", { link = "String" })
hl("@number", { link = "Number" })
hl("@boolean", { link = "Boolean" })
hl("@keyword", { link = "Keyword" })
hl("@function", { link = "Function" })
hl("@function.builtin", { fg = c.term6 })
hl("@type", { link = "Type" })
hl("@variable", { fg = c.ink })
hl("@variable.member", { fg = c.term6 })
hl("@property", { fg = c.term6 })
hl("@operator", { link = "Operator" })
hl("@punctuation", { link = "Delimiter" })
hl("@constant", { link = "Constant" })
hl("@tag", { link = "Tag" })
hl("@attribute", { fg = c.term5 })
hl("@markup.heading", { fg = c.signal, bold = true })
hl("@markup.link", { fg = c.cue, underline = true })
hl("@diff.plus", { link = "DiffAdd" })
hl("@diff.minus", { link = "DiffDelete" })
hl("@diff.delta", { link = "DiffChange" })
