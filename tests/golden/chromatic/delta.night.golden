# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette hornero-signal-night (dark). Include in ~/.config/git/config.user:
#   [include]
#     path = ~/.config/git/hornero-chromatic.gitconfig
#   [delta]
#     features = hornero-chromatic
[delta "hornero-chromatic"]

  dark = true
  light = false


  file-style = "#F2AC52 bold"
  file-decoration-style = "#8393A6 ul"
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "#8BCEF0 bold"
  hunk-header-line-number-style = "#A9B7C6"
  hunk-header-decoration-style = "#2D3B4B box"
  line-numbers = true
  line-numbers-left-style = "#8999AB"
  line-numbers-right-style = "#8999AB"
  line-numbers-minus-style = "#FF8494"
  line-numbers-plus-style = "#8DDBAF"
  line-numbers-zero-style = "#8999AB"
  minus-style = "#FFD6DC #421922"
  minus-emph-style = "#24070C #FF8494 bold"
  minus-non-emph-style = "#FFD6DC #421922"
  plus-style = "#D1F5E0 #153425"
  plus-emph-style = "#071D12 #8DDBAF bold"
  plus-non-emph-style = "#D1F5E0 #153425"
  zero-style = "#E6EBF1 #141B24"
  whitespace-error-style = "#24070C #FF8494 reverse"
  blame-palette = "#141B24 #1B2430 #24303D #2C3947"
  commit-decoration-style = "#F2AC52 box"
  commit-style = "#F2AC52 bold"
  grep-file-style = "#8BCEF0 bold"
  grep-line-number-style = "#A9B7C6"
  grep-match-style = "#1E1304 #F2AC52 bold"

[color "diff"]
  meta = "#8BCEF0 bold"
  frag = "#F2AC52 bold"
  func = "#A9B7C6"
  old = "#FF8494"
  new = "#8DDBAF"
  context = "#E6EBF1"
  commit = "#F2AC52"
  whitespace = "#FF8494 reverse"

[color "branch"]
  current = "#F2AC52 reverse"
  local = "#E6EBF1"
  remote = "#8DDBAF"
  upstream = "#8BCEF0"

[color "status"]
  added = "#8DDBAF"
  changed = "#F2AC52"
  untracked = "#8BCEF0"
  deleted = "#FF8494"
  branch = "#F2AC52 bold"
