# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette hornero-signal-night (dark). Include in ~/.config/git/config.user:
#   [include]
#     path = ~/.config/git/hornero-chromatic.gitconfig
#   [delta]
#     features = hornero-chromatic
[delta "hornero-chromatic"]

  dark = true
  light = false


  file-style = "#F2A33A bold"
  file-decoration-style = "#707A85 ul"
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "#7EC1EA bold"
  hunk-header-line-number-style = "#A8ABAD"
  hunk-header-decoration-style = "#2C333C box"
  line-numbers = true
  line-numbers-left-style = "#737980"
  line-numbers-right-style = "#737980"
  line-numbers-minus-style = "#F0705A"
  line-numbers-plus-style = "#8BD49A"
  line-numbers-zero-style = "#737980"
  minus-style = "#FFD3CA #3D1A14"
  minus-emph-style = "#1E0905 #F0705A bold"
  minus-non-emph-style = "#FFD3CA #3D1A14"
  plus-style = "#CDEFD4 #173222"
  plus-emph-style = "#07170C #8BD49A bold"
  plus-non-emph-style = "#CDEFD4 #173222"
  zero-style = "#ECE6DA #13171D"
  whitespace-error-style = "#1E0905 #F0705A reverse"
  blame-palette = "#13171D #181D24 #1F252E #283039"
  commit-decoration-style = "#F2A33A box"
  commit-style = "#F2A33A bold"
  grep-file-style = "#7EC1EA bold"
  grep-line-number-style = "#A8ABAD"
  grep-match-style = "#1A1205 #F2A33A bold"

[color "diff"]
  meta = "#7EC1EA bold"
  frag = "#F2A33A bold"
  func = "#A8ABAD"
  old = "#F0705A"
  new = "#8BD49A"
  context = "#ECE6DA"
  commit = "#F2A33A"
  whitespace = "#F0705A reverse"

[color "branch"]
  current = "#F2A33A reverse"
  local = "#ECE6DA"
  remote = "#8BD49A"
  upstream = "#7EC1EA"

[color "status"]
  added = "#8BD49A"
  changed = "#F2A33A"
  untracked = "#7EC1EA"
  deleted = "#F0705A"
  branch = "#F2A33A bold"
