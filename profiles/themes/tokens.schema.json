{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hornero.os/config/tokens.schema.json",
  "title": "HorneroOS Hornero Signal theme (schema v2)",
  "description": "A Hornero Signal theme pack: the RFC 0001 §3.1 colour roles in `palette`, a 16-colour ANSI `terminal` palette and apply metadata (GTK/icon theme, wallpaper). Contrast rules (WCAG AA text 4.5:1 on sunken/base/panel/raised, on*-pairs 4.5:1, ruleStrong 3:1 on base/panel/lifted) are enforced by scripts/check-contrast.py, which shares lib/hornero/signal_theme.py with every generator. Additive in 2.1.0: `collection: user` (saved Chromatic palettes) and an optional `chromatic` provenance object. The live scheme document is described by scheme.schema.json; the gate table lives in contrast-gates.json.",
  "version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "mode",
    "palette",
    "terminal",
    "gtkTheme",
    "iconTheme",
    "defaultWallpaper",
    "wallpaperDir"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collection": {
      "enum": [
        "hornero-signal",
        "hornero-originals",
        "user"
      ]
    },
    "collectionOrder": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "gtkTheme": {
      "type": "string",
      "minLength": 1
    },
    "iconTheme": {
      "type": "string",
      "minLength": 1
    },
    "defaultWallpaper": {
      "type": "string",
      "minLength": 1
    },
    "wallpaperDir": {
      "type": "string",
      "minLength": 1
    },
    "colorOnly": {
      "type": "boolean",
      "description": "The theme applies colours without requiring its wallpaper media to be installed."
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground",
        "sunken",
        "base",
        "panel",
        "raised",
        "lifted",
        "ink",
        "inkMuted",
        "inkFaint",
        "rule",
        "ruleStrong",
        "signal",
        "onSignal",
        "signalWell",
        "onSignalWell",
        "cue",
        "onCue",
        "cueWell",
        "onCueWell",
        "phosphor",
        "onPhosphor",
        "phosphorWell",
        "onPhosphorWell",
        "alert",
        "onAlert",
        "alertWell",
        "onAlertWell",
        "inverse",
        "onInverse",
        "inverseSignal",
        "scrim",
        "shadow",
        "focus"
      ],
      "properties": {
        "ground": {
          "$ref": "#/$defs/hexColor"
        },
        "sunken": {
          "$ref": "#/$defs/hexColor"
        },
        "base": {
          "$ref": "#/$defs/hexColor"
        },
        "panel": {
          "$ref": "#/$defs/hexColor"
        },
        "raised": {
          "$ref": "#/$defs/hexColor"
        },
        "lifted": {
          "$ref": "#/$defs/hexColor"
        },
        "ink": {
          "$ref": "#/$defs/hexColor"
        },
        "inkMuted": {
          "$ref": "#/$defs/hexColor"
        },
        "inkFaint": {
          "$ref": "#/$defs/hexColor"
        },
        "rule": {
          "$ref": "#/$defs/hexColor"
        },
        "ruleStrong": {
          "$ref": "#/$defs/hexColor"
        },
        "signal": {
          "$ref": "#/$defs/hexColor"
        },
        "onSignal": {
          "$ref": "#/$defs/hexColor"
        },
        "signalWell": {
          "$ref": "#/$defs/hexColor"
        },
        "onSignalWell": {
          "$ref": "#/$defs/hexColor"
        },
        "cue": {
          "$ref": "#/$defs/hexColor"
        },
        "onCue": {
          "$ref": "#/$defs/hexColor"
        },
        "cueWell": {
          "$ref": "#/$defs/hexColor"
        },
        "onCueWell": {
          "$ref": "#/$defs/hexColor"
        },
        "phosphor": {
          "$ref": "#/$defs/hexColor"
        },
        "onPhosphor": {
          "$ref": "#/$defs/hexColor"
        },
        "phosphorWell": {
          "$ref": "#/$defs/hexColor"
        },
        "onPhosphorWell": {
          "$ref": "#/$defs/hexColor"
        },
        "alert": {
          "$ref": "#/$defs/hexColor"
        },
        "onAlert": {
          "$ref": "#/$defs/hexColor"
        },
        "alertWell": {
          "$ref": "#/$defs/hexColor"
        },
        "onAlertWell": {
          "$ref": "#/$defs/hexColor"
        },
        "inverse": {
          "$ref": "#/$defs/hexColor"
        },
        "onInverse": {
          "$ref": "#/$defs/hexColor"
        },
        "inverseSignal": {
          "$ref": "#/$defs/hexColor"
        },
        "scrim": {
          "$ref": "#/$defs/hexColor"
        },
        "shadow": {
          "$ref": "#/$defs/hexColor"
        },
        "focus": {
          "$ref": "#/$defs/hexColor"
        },
        "glow": {
          "$ref": "#/$defs/hexColor",
          "description": "Optional (RFC 0001 amendment 2): live-signal emphasis; consumers default to `signal` when absent."
        }
      }
    },
    "terminal": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/hexColor"
      },
      "description": "ANSI colours 0-15 (term0…term15); background is palette.base, foreground palette.ink."
    },
    "chromatic": {
      "$ref": "#/$defs/chromaticSaved"
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "chromaticRequest": {
      "type": "object",
      "description": "Request that produced the palette (RFC 0002 §8.3 keys). Open-ended on purpose: unknown keys are ignored by readers.",
      "additionalProperties": true
    },
    "chromaticSaved": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance of a saved Chromatic palette (RFC 0002 §8.2). Informational: the palette itself is authoritative.",
      "required": [
        "engine",
        "algorithm",
        "request"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "integer",
          "minimum": 1
        },
        "request": {
          "$ref": "#/$defs/chromaticRequest"
        },
        "seeds": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/hexColor"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "sourceKey": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "resolved": {
          "$ref": "#/$defs/chromaticResolved"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sha256OrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chromaticResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "variant",
        "contrast"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "variant": {
          "enum": [
            "balanced",
            "vibrant",
            "expressive",
            "faithful",
            "muted",
            "monochrome",
            "high-contrast",
            "neon"
          ]
        },
        "contrast": {
          "enum": [
            "standard",
            "boosted",
            "maximum"
          ]
        }
      }
    }
  }
}
