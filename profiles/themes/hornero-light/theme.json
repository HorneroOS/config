{
  "$schema": "../tokens.schema.json",
  "schemaVersion": 1,
  "id": "hornero-light",
  "name": "Hornero Light",
  "family": "hornero",
  "collection": "hornero-originals",
  "collectionOrder": 4,
  "mode": "light",
  "version": "1.0.0",
  "tokensVersion": "1.0.0",
  "description": "Flagship Hornero light theme: clean Orchis-style neutrals with a varied accent family - blue primary, hornero orange badges, green, red and amber semantics - a first-class light ramp, not an inverted dark",
  "tags": [
    "hornero",
    "flagship",
    "material",
    "varied",
    "light"
  ],
  "darkMode": false,
  "schemeType": "vibrant",
  "gtkTheme": "Hornero-Light",
  "iconTheme": "Papirus",
  "gtkPreferDark": false,
  "defaultWallpaper": "hornero-light-01.png",
  "wallpaperDir": "hornero-light",
  "palette": {
    "background": "#F2F2F2",
    "surface": "#FFFFFF",
    "surfaceVariant": "#E8EAED",
    "onSurfaceVariant": "#3C4043",
    "text": "#212121",
    "textMuted": "#5F6368",
    "primary": "#1A73E8",
    "onPrimary": "#FFFFFF",
    "secondary": "#546E7A",
    "onSecondary": "#FFFFFF",
    "accent": "#B85C00",
    "onAccent": "#FFFFFF",
    "border": "#D9D9D9",
    "error": "#C62828",
    "onError": "#FFFFFF",
    "success": "#0C7C42",
    "onSuccess": "#FFFFFF"
  },
  "components": {
    "window": {
      "description": "Application window body text",
      "background": "#F2F2F2",
      "foreground": "#212121"
    },
    "panel": {
      "description": "Panels, sidebars and header bars",
      "background": "#FFFFFF",
      "foreground": "#212121"
    },
    "card": {
      "description": "Raised cards and popovers",
      "background": "#E8EAED",
      "foreground": "#3C4043"
    },
    "buttonPrimary": {
      "description": "Primary action (Orchis blue)",
      "background": "#1A73E8",
      "foreground": "#FFFFFF"
    },
    "buttonSecondary": {
      "description": "Secondary action (blue grey)",
      "background": "#546E7A",
      "foreground": "#FFFFFF"
    },
    "accentBadge": {
      "description": "Highlights and badges (hornero orange)",
      "background": "#B85C00",
      "foreground": "#FFFFFF"
    },
    "input": {
      "description": "Text entries and search fields",
      "background": "#FFFFFF",
      "foreground": "#212121"
    },
    "mutedText": {
      "description": "Secondary text on surfaces",
      "background": "#FFFFFF",
      "foreground": "#5F6368"
    },
    "tooltip": {
      "description": "Tooltips and scrim overlays",
      "background": "#212121",
      "foreground": "#F2F2F2"
    },
    "errorBanner": {
      "description": "Errors and destructive actions",
      "background": "#C62828",
      "foreground": "#FFFFFF"
    },
    "successBanner": {
      "description": "Confirmations and success states",
      "background": "#0C7C42",
      "foreground": "#FFFFFF"
    }
  }
}
