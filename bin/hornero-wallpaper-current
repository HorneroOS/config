#!/usr/bin/env bash
## Provenance: COPY (never moved) from ulises-jeremias/dotfiles@b26db04
## home/dot_local/bin/executable_hornero-wallpaper-current via read-only reference clone.
## Local changes vs upstream: `executable_` chezmoi deploy prefix stripped.
## Needs lib/hornero/wallpaper-resolver.sh (already shipped).

## Copyright (C) 2019-2025 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## ## Print the path of the currently applied wallpaper
##
## Usage:
##     @script.name [OPTION] ARGUMENTS...
## Print the resolved absolute path to the current wallpaper (same rules as wallpaper-resolver).
set -euo pipefail

if [[ -f "$HOME/.local/lib/hornero/wallpaper-resolver.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.local/lib/hornero/wallpaper-resolver.sh"
fi

if ! declare -f hornero_current_wallpaper >/dev/null 2>&1; then
  exit 1
fi

path="$(hornero_current_wallpaper "${1:-}" 2>/dev/null || true)"
if [[ -n ${path:-} && -f $path ]]; then
  printf '%s\n' "$path"
  exit 0
fi

exit 1
