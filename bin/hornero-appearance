#!/usr/bin/env bash

## hornero-appearance: Appearance manager (Hornero Signal themes, wallpaper, GTK).
## Copyright (C) 2019-2026 Ulises Jeremias Cornejo Fandos
## Licensed under MIT.
##
## A theme apply writes the live Signal scheme the shell watches
## (${XDG_STATE_HOME}/hornero/signal/scheme.json). Wallpapers never recolour.

set -euo pipefail

# All appearance state uses the Hornero XDG namespace. Explicit HORNERO_* values
# let the shell and CLI share the same locations in tests and packaged installs.
_HORNERO_DATA_BASE="${XDG_DATA_HOME:-$HOME/.local/share}"
_HORNERO_STATE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}"
_HORNERO_CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}"
HORNERO_THEMES_DIR="${HORNERO_THEMES_DIR:-$_HORNERO_DATA_BASE/hornero/themes}"
HORNERO_STATE_DIR="${HORNERO_STATE_DIR:-$_HORNERO_STATE_BASE/hornero}"
HORNERO_CACHE_DIR="${HORNERO_CACHE_DIR:-$_HORNERO_CACHE_BASE/hornero}"
HORNERO_SCHEME_STATE_FILE="${HORNERO_SCHEME_STATE_FILE:-$HORNERO_STATE_DIR/scheme/state.json}"
HORNERO_SIGNAL_SCHEME="${HORNERO_SIGNAL_SCHEME:-$HORNERO_STATE_DIR/signal/scheme.json}"
HORNERO_WALLPAPER_POINTER="${HORNERO_WALLPAPER_POINTER:-$HORNERO_STATE_DIR/wallpaper/path}"
HORNERO_HYPRLOCK_COLORS="${HORNERO_HYPRLOCK_COLORS:-$HORNERO_CACHE_DIR/smart-colors/colors-hyprlock.conf}"

_appearance_resolve_state_file() { printf '%s\n' "$HORNERO_SCHEME_STATE_FILE"; }
_appearance_resolve_scheme_file() { printf '%s\n' "$HORNERO_SIGNAL_SCHEME"; }
_appearance_resolve_hyprlock_colors() { printf '%s\n' "$HORNERO_HYPRLOCK_COLORS"; }
_appearance_resolve_pointer() {
  printf '%s\n' "${HORNERO_WALLPAPER_POINTER_FILE:-$HORNERO_WALLPAPER_POINTER}"
}
_appearance_resolve_theme_json() {
  printf '%s\n' "$HORNERO_THEMES_DIR/${1:-}/theme.json"
}

cmd="${1:-}"
shift 2>/dev/null || true

json_escape() {
	python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$1"
}

_wait_appearance_ipc() {
	local _i busy="" last_error
	for _i in $(seq 1 120); do
		if ! busy="$(quickshell ipc call appearance isBusy 2>/dev/null)"; then
			echo "Error: failed to poll appearance isBusy via Quickshell IPC" >&2
			return 1
		fi
		busy="${busy//$'\r'/}"
		busy="${busy//$'\n'/}"
		[[ $busy == "1" ]] || break
		sleep 0.5
	done
	if [[ $busy == "1" ]]; then
		echo "Error: appearance apply timed out waiting for Quickshell" >&2
		return 1
	fi
	last_error="$(quickshell ipc call appearance lastError 2>/dev/null || true)"
	last_error="${last_error//$'\r'/}"
	last_error="${last_error//$'\n'/}"
	if [[ -n $last_error ]]; then
		echo "Error: appearance apply failed: $last_error" >&2
		return 1
	fi
	return 0
}

cmd_theme_list() {
	local script="${HOME}/.local/lib/hornero/list-themes.py"
	if [[ -f $script ]]; then
		python3 "$script" "$HORNERO_THEMES_DIR"
	else
		echo "[]"
	fi
}

cmd_theme_show() {
	local id="${1:-}"
	[[ -n $id ]] || {
		echo "Usage: hornero-appearance theme show <id>" >&2
		exit 1
	}
	local path
	path="$(_appearance_resolve_theme_json "$id")"
	[[ -f $path ]] || {
		echo "Theme not found: $id" >&2
		exit 1
	}
	cat "$path"
}

_shell_theme_apply() {
	local id="$1"
	local wallpaper="${2:-}"
	# shellcheck source=/dev/null
	source "$HOME/.local/lib/hornero/wallpaper-resolver.sh" 2>/dev/null || true
	# shellcheck source=/dev/null
	source "$HOME/.local/lib/hornero/apply-appearance.sh"
	hornero_apply_theme "$id" "$wallpaper"
}

cmd_theme_apply() {
	local id="${1:-}"
	local wallpaper=""
	shift 2>/dev/null || true
	while [[ $# -gt 0 ]]; do
		case "${1:-}" in
		--wallpaper)
			[[ -n ${2:-} ]] || {
				echo "hornero-appearance theme apply: --wallpaper requires a path" >&2
				exit 1
			}
			wallpaper="$2"
			shift 2
			;;
		*)
			echo "hornero-appearance theme apply: unknown argument: $1" >&2
			exit 1
			;;
		esac
	done

	[[ -n $id ]] || {
		echo "Usage: hornero-appearance theme apply <id> [--wallpaper <path>]" >&2
		exit 1
	}

	if pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1; then
		local ipc_out=""
		if ipc_out="$(quickshell ipc call appearance applyTheme "$id" "${wallpaper:-}" 2>&1)"; then
			case "$ipc_out" in
			"Target not found."* | *"Target not found"*)
				echo "Warning: Quickshell IPC unavailable ($ipc_out); falling back to shell apply" >&2
				;;
			*)
				_wait_appearance_ipc || exit 1
				exit 0
				;;
			esac
		else
			echo "Warning: Quickshell IPC failed; falling back to shell apply" >&2
		fi
	fi

	_shell_theme_apply "$id" "$wallpaper"
}

cmd_theme() {
	local sub="${1:-}"
	shift 2>/dev/null || true
	case "$sub" in
	list) cmd_theme_list ;;
	show) cmd_theme_show "${1:-}" ;;
	apply) cmd_theme_apply "$@" ;;
	*)
		cat <<'EOF' >&2
Usage: hornero-appearance theme <list|show|apply> …

  theme list
  theme show <id>
  theme apply <id> [--wallpaper <path>]
EOF
		exit 1
		;;
	esac
}

_appearance_scheme_field() {
	python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get(sys.argv[2], ""))' "$1" "$2" 2>/dev/null || true
}

cmd_status() {
	local wallpaper="" theme="" mode="" gtk_theme="" icon_theme="" gtk_color_scheme=""
	if command -v hornero-wallpaper-current >/dev/null 2>&1; then
		wallpaper="$(hornero-wallpaper-current 2>/dev/null || true)"
	fi
	local scheme state_file
	scheme="$(_appearance_resolve_scheme_file)"
	if [[ -f $scheme ]]; then
		theme="$(_appearance_scheme_field "$scheme" id)"
		mode="$(_appearance_scheme_field "$scheme" mode)"
	fi
	state_file="$(_appearance_resolve_state_file)"
	if [[ -f $state_file ]]; then
		gtk_color_scheme="$(_appearance_scheme_field "$state_file" gtkColorScheme)"
	fi
	[[ -n $gtk_color_scheme ]] || gtk_color_scheme="follow"
	if [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini ]]; then
		gtk_theme="$(grep -E '^gtk-theme-name=' "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" 2>/dev/null | head -n1 | cut -d= -f2- || true)"
	fi
	if command -v gsettings >/dev/null 2>&1; then
		icon_theme="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'\"" || true)"
	fi

	if [[ ${1:-} == "--json" ]]; then
		printf '{"theme":%s,"mode":%s,"wallpaper":%s,"gtkTheme":%s,"iconTheme":%s,"gtkColorScheme":%s}\n' \
			"$(json_escape "${theme:-}")" \
			"$(json_escape "${mode:-}")" \
			"$(json_escape "${wallpaper:-}")" \
			"$(json_escape "${gtk_theme:-}")" \
			"$(json_escape "${icon_theme:-}")" \
			"$(json_escape "${gtk_color_scheme:-}")"
	else
		echo "theme          : ${theme:-}"
		echo "mode           : ${mode:-}"
		echo "wallpaper      : ${wallpaper:-}"
		echo "gtkTheme       : ${gtk_theme:-}"
		echo "iconTheme      : ${icon_theme:-}"
		echo "gtkColorScheme : ${gtk_color_scheme:-}"
	fi
}

cmd_set_wallpaper() {
	local wallpaper="${1:-}"
	[[ -n $wallpaper ]] || {
		echo "Usage: hornero-appearance set-wallpaper <path>" >&2
		exit 1
	}
	hornero-wallpaper-set "$wallpaper"
}

cmd_set_gtk() {
	local theme="${1:-}"
	[[ -n $theme ]] || {
		echo "Usage: hornero-appearance set-gtk <theme>" >&2
		exit 1
	}
	if pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1; then
		if quickshell ipc call appearance setGtk "$theme" >/dev/null 2>&1; then
			_wait_appearance_ipc || exit 1
			exit 0
		fi
	fi
	local icon
	icon="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'" || true)"
	[[ -n $icon ]] || icon="Numix-Circle"
	# Omit color-scheme so live gtkColorScheme policy is preserved.
	hornero-gtk-theme -q apply "$theme" "$icon"
}

cmd_set_gtk_color_scheme() {
	local policy="${1:-}"
	[[ -n $policy ]] || {
		echo "Usage: hornero-appearance set-gtk-color-scheme <follow|default|prefer-light|prefer-dark>" >&2
		exit 1
	}
	if pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1; then
		if quickshell ipc call appearance setGtkColorScheme "$policy" >/dev/null 2>&1; then
			_wait_appearance_ipc || exit 1
			exit 0
		fi
	fi
	hornero-gtk-theme -q color-scheme "$policy"
}

cmd_set_icons() {
	local theme="${1:-}"
	[[ -n $theme ]] || {
		echo "Usage: hornero-appearance set-icons <theme>" >&2
		exit 1
	}
	if pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1; then
		if quickshell ipc call appearance setIcons "$theme" >/dev/null 2>&1; then
			_wait_appearance_ipc || exit 1
			exit 0
		fi
	fi
	hornero-gtk-theme -q set-icons "$theme"
}

cmd_sync() {
	if pgrep -x qs 2>/dev/null || pgrep -x quickshell >/dev/null 2>&1; then
		if quickshell ipc call appearance reload >/dev/null 2>&1; then
			_wait_appearance_ipc || exit 1
		fi
	fi
}

cmd_doctor() {
	local ok=0 scheme pointer_val="" resolved="" hyprlock_conf hyprlock_bytes=0
	scheme="$(_appearance_resolve_scheme_file)"
	hyprlock_conf="$(_appearance_resolve_hyprlock_colors)"
	pointer_val="$(cat "$(_appearance_resolve_pointer)" 2>/dev/null | head -n1 || true)"
	if command -v hornero-wallpaper-current >/dev/null 2>&1; then
		resolved="$(hornero-wallpaper-current 2>/dev/null || true)"
	fi
	[[ -f $hyprlock_conf ]] && hyprlock_bytes="$(wc -c <"$hyprlock_conf" | tr -d ' ')"
	local lib="${HOME}/.local/lib/hornero"
	[[ -f $lib/signal_theme.py ]] || lib="/usr/share/hornero/lib/hornero"

	echo "signal.scheme  : $scheme"
	echo "scheme.theme   : $(_appearance_scheme_field "$scheme" id)"
	echo "scheme.mode    : $(_appearance_scheme_field "$scheme" mode)"
	echo "wallpaper.ptr  : ${pointer_val:-"(missing)"}"
	echo "wallpaper.res  : ${resolved:-"(missing)"}"
	echo "hyprlock.conf  : ${hyprlock_bytes} bytes ($hyprlock_conf)"

	if [[ ! -f $scheme ]]; then
		echo "FAIL: live Signal scheme missing (run: hornero-appearance theme apply hornero-signal-night)" >&2
		ok=1
	elif [[ -f $lib/signal_render.py ]] && ! python3 "$lib/signal_render.py" --theme "$scheme" \
		--hyprlock-output /dev/null >/dev/null 2>&1; then
		echo "FAIL: live Signal scheme does not satisfy schema v2 + contrast rules" >&2
		ok=1
	fi
	if [[ -n $pointer_val && ! -f $pointer_val ]]; then
		echo "FAIL: wallpaper pointer does not exist: $pointer_val" >&2
		ok=1
	fi
	if [[ -n $pointer_val && -n $resolved ]]; then
		if [[ "$(readlink -f "$pointer_val" 2>/dev/null || true)" != "$(readlink -f "$resolved" 2>/dev/null || true)" ]]; then
			echo "FAIL: pointer != hornero-wallpaper-current ($pointer_val vs $resolved)" >&2
			ok=1
		fi
	fi
	if [[ ${hyprlock_bytes:-0} -eq 0 ]]; then
		echo "WARN: colors-hyprlock.conf missing; hyprlock uses the factory Signal Night values" >&2
	fi

	if [[ $ok -eq 0 ]]; then
		echo "OK: appearance state is consistent"
	else
		echo "DONE: inconsistencies detected (exit $ok)"
	fi
	return "$ok"
}

case "${cmd:-}" in
theme) cmd_theme "$@" ;;
status) cmd_status "${1:-}" ;;
set-wallpaper) cmd_set_wallpaper "${1:-}" ;;
set-gtk) cmd_set_gtk "${1:-}" ;;
set-gtk-color-scheme) cmd_set_gtk_color_scheme "${1:-}" ;;
set-icons) cmd_set_icons "${1:-}" ;;
sync) cmd_sync ;;
doctor) cmd_doctor ;;
*)
	cat <<'EOF' >&2
Usage: hornero-appearance <command> [args]

Commands:
  status [--json]
  theme list|show <id>|apply <id> [--wallpaper <path>]
  set-wallpaper <path>
  set-gtk <theme>
  set-gtk-color-scheme <follow|default|prefer-light|prefer-dark>
  set-icons <theme>
  sync
  doctor
EOF
	exit 1
	;;
esac
