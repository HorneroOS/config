 */
:root {
  --hornero-ground: {{ ground }};
  --hornero-base: {{ base }};
  --hornero-panel: {{ panel }};
  --hornero-raised: {{ raised }};
  --hornero-lifted: {{ lifted }};
  --hornero-sunken: {{ sunken }};
  --hornero-ink: {{ ink }};
  --hornero-ink-muted: {{ inkMuted }};
  --hornero-ink-faint: {{ inkFaint }};
  --hornero-signal: {{ signal }};
  --hornero-on-signal: {{ onSignal }};
  --hornero-cue: {{ cue }};
  --hornero-cue-well: {{ cueWell }};
  --hornero-on-cue-well: {{ onCueWell }};
  --hornero-rule: {{ rule }};
  --hornero-rule-strong: {{ ruleStrong }};

  --lwt-accent-color: {{ ground }} !important;
  --lwt-text-color: {{ ink }} !important;
  --toolbar-bgcolor: {{ base }} !important;
  --toolbar-color: {{ ink }} !important;
  --toolbar-field-background-color: {{ sunken }} !important;
  --toolbar-field-color: {{ ink }} !important;
  --toolbar-field-border-color: {{ rule }} !important;
  --toolbar-field-focus-background-color: {{ raised }} !important;
  --toolbar-field-focus-border-color: {{ signal }} !important;
  --toolbarseparator-color: {{ rule }} !important;
  --tab-selected-bgcolor: {{ raised }} !important;
  --tab-selected-textcolor: {{ ink }} !important;
  --lwt-tab-line-color: {{ signal }} !important;
  --arrowpanel-background: {{ panel }} !important;
  --arrowpanel-color: {{ ink }} !important;
  --arrowpanel-border-color: {{ ruleStrong }} !important;
  --chrome-content-separator-color: {{ rule }} !important;
}
