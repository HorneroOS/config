# Hornero Chromatic — GENERATED by horneroctl from semantic Signal roles; do not hand-edit.
# Palette {{ id }} ({{ mode }}). Include in ~/.config/git/config.user:
#   [include]
#     path = ~/.config/git/hornero-chromatic.gitconfig
#   [delta]
#     features = hornero-chromatic
[delta "hornero-chromatic"]
{{#dark}}
  dark = true
  light = false
{{/dark}}
{{#light}}
  dark = false
  light = true
{{/light}}
  file-style = "{{ signal }} bold"
  file-decoration-style = "{{ ruleStrong }} ul"
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [->]
  hunk-header-style = "file line-number syntax"
  hunk-header-file-style = "{{ cue }} bold"
  hunk-header-line-number-style = "{{ inkMuted }}"
  hunk-header-decoration-style = "{{ rule }} box"
  line-numbers = true
  line-numbers-left-style = "{{ inkFaint }}"
  line-numbers-right-style = "{{ inkFaint }}"
  line-numbers-minus-style = "{{ alert }}"
  line-numbers-plus-style = "{{ phosphor }}"
  line-numbers-zero-style = "{{ inkFaint }}"
  minus-style = "{{ onAlertWell }} {{ alertWell }}"
  minus-emph-style = "{{ onAlert }} {{ alert }} bold"
  minus-non-emph-style = "{{ onAlertWell }} {{ alertWell }}"
  plus-style = "{{ onPhosphorWell }} {{ phosphorWell }}"
  plus-emph-style = "{{ onPhosphor }} {{ phosphor }} bold"
  plus-non-emph-style = "{{ onPhosphorWell }} {{ phosphorWell }}"
  zero-style = "{{ ink }} {{ base }}"
  whitespace-error-style = "{{ onAlert }} {{ alert }} reverse"
  blame-palette = "{{ base }} {{ panel }} {{ raised }} {{ lifted }}"
  commit-decoration-style = "{{ signal }} box"
  commit-style = "{{ signal }} bold"
  grep-file-style = "{{ cue }} bold"
  grep-line-number-style = "{{ inkMuted }}"
  grep-match-style = "{{ onSignal }} {{ signal }} bold"

[color "diff"]
  meta = "{{ cue }} bold"
  frag = "{{ signal }} bold"
  func = "{{ inkMuted }}"
  old = "{{ alert }}"
  new = "{{ phosphor }}"
  context = "{{ ink }}"
  commit = "{{ signal }}"
  whitespace = "{{ alert }} reverse"

[color "branch"]
  current = "{{ signal }} reverse"
  local = "{{ ink }}"
  remote = "{{ phosphor }}"
  upstream = "{{ cue }}"

[color "status"]
  added = "{{ phosphor }}"
  changed = "{{ signal }}"
  untracked = "{{ cue }}"
  deleted = "{{ alert }}"
  branch = "{{ signal }} bold"
